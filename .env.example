# URL pública del sitio, sin / final (local: http://localhost:3000)
APP_URL=http://localhost:3000
# Supabase: Project Settings > API
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR
# Mercado Pago: usar TEST-... en pruebas, APP_USR-... en producción
MERCADOPAGO_ACCESS_TOKEN=TEST-REEMPLAZAR
# Mercado Pago: clave secreta de la configuración de webhooks
MERCADOPAGO_WEBHOOK_SECRET=REEMPLAZAR
# Admin: contraseña robusta y secreto aleatorio (mínimo 32 caracteres)
ADMIN_PASSWORD=REEMPLAZAR
ADMIN_SESSION_SECRET=REEMPLAZAR_CON_32_CARACTERES_O_MAS
